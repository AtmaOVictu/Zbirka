{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vbl/claim-record.schema.json",
  "title": "VBL Claim Verification Record (proposed)",
  "description": "Proposed machine-readable structure for one VBL claim. This schema is a draft and is not itself a verification authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "claim",
    "claim_type",
    "claim_status",
    "structure_status",
    "source",
    "evidence",
    "scope",
    "limitations",
    "counterevidence",
    "responsibility",
    "challenge_route",
    "correction",
    "test_results",
    "publication",
    "independent_review",
    "legal_review",
    "created_at",
    "record_status"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "observation",
        "measurement",
        "inference",
        "interpretation",
        "proposal",
        "subjective_testimony",
        "legal_assertion",
        "other"
      ]
    },
    "claim_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "CONTRADICTED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "structure_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verbatim_or_reference",
        "source_uri_or_location",
        "artifact_sha256",
        "source_state"
      ],
      "properties": {
        "verbatim_or_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_uri_or_location": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-fA-F0-9]{64})$"
        },
        "source_state": {
          "enum": [
            "PRESENT",
            "MISSING",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "description",
          "method",
          "result"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-fA-F0-9]{64})$"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "tool_and_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "INCONCLUSIVE",
              "NOT_RUN"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_or_role",
        "executor",
        "conflict_of_interest"
      ],
      "properties": {
        "process_or_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "executor": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_of_interest": {
          "enum": [
            "NONE_DECLARED",
            "PRESENT",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        }
      }
    },
    "challenge_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "route",
        "status"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_record_ref",
        "reason",
        "event_status"
      ],
      "properties": {
        "prior_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_status": {
          "enum": [
            "NONE",
            "PROPOSED",
            "APPLIED",
            "REJECTED",
            "NOT_APPLICABLE"
          ]
        },
        "history_preserved": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "status",
          "object_tested",
          "environment"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "object_tested": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "uri",
        "immutable_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "PUBLISHED",
            "NOT_PUBLISHED",
            "ATTEMPTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "immutable_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "scope",
        "conflict_of_interest"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "NOT_AVAILABLE",
            "NOT_REQUESTED",
            "NOT_APPLICABLE"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_of_interest": {
          "enum": [
            "NONE_DECLARED",
            "PRESENT",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        }
      }
    },
    "legal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_or_basis",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "PENDING",
            "NOT_REQUESTED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "reviewer_or_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    }
  }
}
